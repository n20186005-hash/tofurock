---
import BaseLayout from "@/layouts/BaseLayout.astro";
import MapEmbed from "@/components/MapEmbed.astro";
import PageHero from "@/components/PageHero.astro";
import WeatherWidget from "@/components/WeatherWidget.astro";
import { attraction, createAttractionStructuredData, parkingInfo, parkingSpots, transportOptions } from "@/data/site";
---
<BaseLayout title="頭前溪豆腐岩交通與停車場｜開車導航、公車轉乘、豆腐岩怎麼去" description="頭前溪豆腐岩怎麼去？整理頭前溪停車場位置、免費停車、開車導航、高鐵台鐵與公車轉乘、計程車與步行路線，一次搞懂抵達方式。" jsonLd={createAttractionStructuredData(Astro.site)}>
  <PageHero
    kicker="交通指南"
    title="詳細交通與停車"
    description="豆腐岩位在竹北頭前溪河岸，適合以高鐵新竹站、台鐵六家站、竹北市區或頭前溪河濱動線作為出發點。"
    image="/images/gallery-zhubei-skyline.webp"
    imageAlt="從豆腐岩附近望向竹北城市天際線"
  />

  <section class="mx-auto grid max-w-7xl gap-10 px-4 py-12 sm:px-6 lg:grid-cols-[0.9fr_1.1fr] lg:px-8">
    <div>
      <p class="section-kicker">地點定位</p>
      <h2 class="mt-3 text-3xl font-black text-ink-900 sm:text-4xl">地點定位</h2>
      <p class="mt-5 text-lg leading-8 text-ink-900/72">{attraction.address}</p>
      <p class="mt-4 leading-8 text-ink-900/72">可把地圖導航設定為「Tofu Rock」或「頭前溪豆腐岩」，抵達後依現場道路與堤岸通行狀況步行到安全觀景位置。</p>
      <div class="mt-8 rounded-3xl bg-white/75 p-6 ring-1 ring-river-900/10">
        <h3 class="text-xl font-black text-river-900">坐標</h3>
        <p class="mt-3 font-mono text-sm text-ink-900/70">{attraction.latitude}, {attraction.longitude}</p>
      </div>
    </div>
    <MapEmbed />
  </section>

  <section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <p class="section-kicker">抵達方式總覽</p>
    <h2 class="mt-3 text-3xl font-black text-ink-900 sm:text-4xl">抵達方式總覽</h2>
    <div class="mt-8 grid gap-4 md:grid-cols-3">
      {transportOptions.map((option) => (
        <article class="rounded-3xl bg-white/75 p-6 ring-1 ring-river-900/10">
          <h3 class="text-xl font-black text-river-900">{option.title}</h3>
          <p class="mt-4 leading-8 text-ink-900/72">{option.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="mx-auto grid max-w-7xl gap-10 px-4 py-16 sm:px-6 lg:grid-cols-2 lg:px-8">
    <div class="glass-panel rounded-[2rem] p-8">
      <p class="section-kicker">從機場到豆腐岩</p>
      <h2 class="mt-3 text-3xl font-black text-ink-900">從機場到豆腐岩</h2>
      <div class="mt-6 space-y-5">
        <div>
          <h3 class="text-lg font-black text-river-900">桃園國際機場（TPE）</h3>
          <p class="mt-2 leading-8 text-ink-900/72">
            可搭乘機場捷運至高鐵桃園站轉乘台灣高鐵至「高鐵新竹站」，再轉計程車或共享機車前往河岸；或搭乘國道客運直達新竹市區/高鐵新竹站。全程預留約 2–2.5 小時較為從容。
          </p>
        </div>
        <div>
          <h3 class="text-lg font-black text-river-900">台北松山機場（TSA）</h3>
          <p class="mt-2 leading-8 text-ink-900/72">
            可經市區捷運前往台北車站轉乘台灣高鐵至「高鐵新竹站」，再銜接河岸動線；班次密集，適合國內線與部分短程國際線旅客。
          </p>
        </div>
        <p class="rounded-2xl bg-river-900/5 p-4 text-sm leading-7 text-ink-900/74">
            機場到新竹屬跨城移動，建議先到「高鐵新竹站」或「竹北市區」作為中繼點，最後一哩路再以計程車或自行車接續。
          </p>
      </div>
    </div>

    <div class="glass-panel rounded-[2rem] p-8">
      <p class="section-kicker">大眾運輸怎麼到</p>
      <h2 class="mt-3 text-3xl font-black text-ink-900">大眾運輸怎麼到</h2>
      <div class="mt-6 space-y-5">
        <div>
          <h3 class="text-lg font-black text-river-900">高鐵 / 台鐵</h3>
          <p class="mt-2 leading-8 text-ink-900/72">
            高鐵新竹站與台鐵六家站相距很近，是外地旅客最主要的中繼點；部分列車亦可停靠竹北站、新竹站，再轉乘公車或步行接續。
          </p>
        </div>
        <div>
          <h3 class="text-lg font-black text-river-900">市區公車</h3>
          <p class="mt-2 leading-8 text-ink-900/72">
            竹北市區與高鐵新竹站周邊有多條市區公車路線，可縮短到河岸入口的步行距離；實際站位與班距請依當日客運業者公告為準。
          </p>
        </div>
        <div>
          <h3 class="text-lg font-black text-river-900">公共自行車</h3>
          <p class="mt-2 leading-8 text-ink-900/72">
            沿線設有公共自行車租借站點，適合從車站或市區騎往河濱自行車道，再到豆腐岩觀景；記得在還車熱點前留意樁位狀況。
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <p class="section-kicker">計程車與網約車</p>
    <h2 class="mt-3 text-3xl font-black text-ink-900 sm:text-4xl">計程車與網約車</h2>
    <div class="mt-8 grid gap-4 md:grid-cols-2">
      <article class="rounded-3xl bg-white/75 p-6 ring-1 ring-river-900/10">
        <h3 class="text-xl font-black text-river-900">從車站出發</h3>
        <p class="mt-4 leading-8 text-ink-900/72">
          高鐵新竹站、台鐵六家站與竹北市區都有計程車排班與多元網約車可叫車，告知司機「頭前溪河岸 / 豆腐岩」或導航目的地即可。從高鐵新竹站到河岸車程約 10–15 分鐘，會受路段與時段影響。
        </p>
      </article>
      <article class="rounded-3xl bg-white/75 p-6 ring-1 ring-river-900/10">
        <h3 class="text-xl font-black text-river-900">回程與等候</h3>
        <p class="mt-4 leading-8 text-ink-900/72">
          河岸較空曠、夜間車流少，建議先約好回程車或保留可叫車的位置；若攜帶長輩與孩童，可請司機停在靠近堤岸的安全落客點。
        </p>
      </article>
    </div>
  </section>

  <WeatherWidget />

  <section class="mx-auto grid max-w-7xl gap-8 px-4 py-16 sm:px-6 lg:grid-cols-[1fr_1fr] lg:px-8">
    <div class="glass-panel rounded-[2rem] p-8">
      <p class="section-kicker">停車資訊</p>
      <h2 class="mt-3 text-3xl font-black text-ink-900">頭前溪停車場指南</h2>
      <p class="mt-5 leading-8 text-ink-900/72">豆腐岩旁設有<b class="font-black text-river-900">頭前溪河濱公園免費停車場</b>，落車後步行約 3–5 分鐘即可抵達觀景位置，是最靠近的停車選擇。</p>
      <ul class="mt-6 space-y-4">
        {parkingInfo.map((item) => <li class="rounded-2xl bg-white/70 p-5 leading-7 text-ink-900/72">{item}</li>)}
      </ul>
      <div class="mt-6 space-y-4">
        {parkingSpots.map((spot) => (
          <article class="rounded-2xl bg-white/70 p-5 ring-1 ring-river-900/10">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <h3 class="text-lg font-black text-river-900">{spot.name}</h3>
              <span class="rounded-full bg-river-900/10 px-3 py-1 text-xs font-black text-river-900">{spot.fee}</span>
            </div>
            <p class="mt-3 leading-7 text-ink-900/72">{spot.access}</p>
            {spot.gps && <p class="mt-2 font-mono text-xs text-ink-900/60">GPS：{spot.gps}</p>}
            <p class="mt-2 text-sm leading-7 text-ink-900/60">{spot.note}</p>
          </article>
        ))}
      </div>
    </div>
    <div class="glass-panel rounded-[2rem] p-8">
      <p class="section-kicker">遊覽時間</p>
      <h2 class="mt-3 text-3xl font-black text-ink-900">最佳遊覽時段 / 建議停留</h2>
      <p class="mt-6 leading-8 text-ink-900/72">{attraction.suggestedStay}</p>
      <p class="mt-4 leading-8 text-ink-900/72">晴天午後、夕陽前後與橋燈初亮時最容易拍出層次；但夜間請留在堤岸遠拍，不要下到河道。</p>
    </div>
  </section>
</BaseLayout>
