---
import { attraction, navItems } from "@/data/site";
---
<footer class="mt-20 border-t border-river-900/10 bg-river-900 text-tofu-50">
  <div class="mx-auto grid max-w-7xl gap-10 px-4 py-12 sm:px-6 lg:grid-cols-[1.2fr_1fr] lg:px-8">
    <div>
      <h2 class="mt-3 text-3xl font-black text-balance">{attraction.name}</h2>
      <p class="mt-4 max-w-xl text-sm leading-7 text-tofu-50/78">
        這是一個以遊客角度整理的河岸景點指南，協助安排交通、停留時間、照片牆、行程清單與本地紀念卡。
      </p>
    </div>
    <div>
      <h3 class="text-sm font-black tracking-[0.2em] text-tofu-100/80">快速連結</h3>
      <div class="mt-4 grid grid-cols-2 gap-2 text-sm text-tofu-50/78">
        {navItems.map((item) => <a class="rounded-xl px-3 py-2 hover:bg-white/10 hover:text-white" href={item.href}>{item.label}</a>)}
      </div>
    </div>
  </div>
</footer>
